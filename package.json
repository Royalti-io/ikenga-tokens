{
  "name": "@ikenga/tokens",
  "version": "0.3.0",
  "description": "Canonical design tokens for the Ikenga design system. CSS custom properties + TypeScript references. Shared by the shell and every UI pkg.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Royalti-io/ikenga-tokens.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./app-kit.css": "./app-kit.css",
    "./tokens-css": "./dist/tokens-css.js",
    "./app-kit-css": "./dist/app-kit-css.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "tokens.css",
    "app-kit.css",
    "README.md"
  ],
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build": "node scripts/build-css.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-css.mjs --watch & tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
